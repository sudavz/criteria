{
  "name": "@criteria-ts/core",
  "version": "0.1.0-alpha.13",
  "description": "A TypeScript library for building decoupled search and filtering criteria using the Criteria pattern.",
  "license": "MIT",
  "author": "David Suarez sudavz@proton.me",
  "type": "module",
  "main": "./lib/index.js",
  "private": false,
  "homepage": "https://github.com/sudavz/criteria",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudavz/criteria.git"
  },
  "keywords": [
    "criteria",
    "criteria-pattern",
    "specification-pattern",
    "domain-driven-design",
    "ddd",
    "repository-pattern",
    "clean-architecture",
    "filtering",
    "filter",
    "query",
    "query-filter",
    "cursor-pagination",
    "pagination",
    "ast",
    "visitor-pattern",
    "type-safe",
    "typescript"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "^22.22.1 || ^24.0.0 || ^26.0.0"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build:check": "tsc --noEmit",
    "build:prod": "tsc",
    "test": "vitest run --config ../../vitest.test.config.mjs",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write --config ../../.prettierrc .",
    "lint": "eslint --config ../../eslint.config.mjs"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
