        "husky": "^9.1.7",
        "eslint": "^10.14.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-7": "npm:typescript@^7.0.2",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
